# Copy to .env (or export in your shell) — NEVER commit the real .env
# Telegram bot token from @BotFather (Telegram app → search @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-here

# Anthropic API key from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override law library location (default: ../law-library relative to gst_bot.py)
# GST_LIBRARY_DIR=/path/to/law-library
